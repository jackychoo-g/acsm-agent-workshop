# Local overrides only. Copy to .env if you need them; .env is gitignored.
# Shared workshop values (project, bucket, RAG corpus) come from `make configure`,
# which writes .lab.env from Secret Manager. Nothing project-specific belongs here.

# Your name for the agent (acsm-agent-<owner>). Defaults to your gcloud account name.
# ACSM_OWNER=aisyah

# bigquery (default) or rag_engine
# ACSM_RAG_BACKEND=bigquery

# baseline | hillclimb (used by the eval targets)
# ACSM_PROMPT_MODE=baseline

# Model Armor fails open when no token is available; set false to skip it locally.
# ACSM_ENABLE_MODEL_ARMOR=true
